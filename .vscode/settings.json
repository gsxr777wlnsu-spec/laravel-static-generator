{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*-html.md": "yaml"
  },
  "yaml.embedded.languages": {
    "html": ["html"],
    "xml": ["xml"],
    "json": ["json"],
    "javascript": ["js", "javascript"],
    "css": ["css"]
  }
}
